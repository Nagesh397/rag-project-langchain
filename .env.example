# Copy to .env for local development. Never commit .env.
LOG_LEVEL=INFO

# =========================
# 1) OLLAMA CONFIGURATION
# =========================
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=120

OLLAMA_BASE_URL=http://ollama:11434
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# =========================
# 2) OPENAI CONFIGURATION
# =========================
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_TEMPERATURE=0.1
# LLM_TIMEOUT=120
# OPENAI_API_KEY=your_openai_key
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small

# =========================
# 3) GEMINI CONFIGURATION
# =========================
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-1.5-flash
# LLM_TEMPERATURE=0.1
# LLM_TIMEOUT=120
# GOOGLE_API_KEY=your_google_key
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=nomic-embed-text

# =========================
# 4) GROQ CONFIGURATION
# =========================
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_TEMPERATURE=0.1
# LLM_TIMEOUT=120
# GROQ_API_KEY=your_groq_key
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=nomic-embed-text

# API key placeholders (leave blank if not used)
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

VECTOR_STORE=qdrant
COLLECTION_NAME=hospital_knowledge
TOP_K=5
SEARCH_TYPE=similarity
SCORE_THRESHOLD=
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# For local non-Docker runs, change QDRANT_HOST and OLLAMA_BASE_URL to localhost
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=

DOCUMENTS_PATH=data/documents/drive
EVALUATION_DATASET=Extra/evaluation/tests.json
EVALUATION_OUTPUT_PATH=evaluation/results
GRADIO_HOST=0.0.0.0
GRADIO_PORT=7860