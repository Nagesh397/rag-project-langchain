# Copy to .env for local development. Never commit .env.
APP_ENV=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:7860

QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=hospital_knowledge

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_LLM_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

DOCUMENTS_PATH=data/documents/drive
AUDIT_LOG_PATH=data/audit/audit.log
MAX_RETRIEVAL_RESULTS=3
GOOGLE_DRIVE_FOLDER_URL=https://drive.google.com/drive/folders/1pNYWbpFt7ar-HCe1c25iYjOG5FgjENDU?usp=sharing
