{
  "servers": {
    "ai-git-assistant": {
      "type": "stdio",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "${workspaceFolder}/my-github-mcp/server.py"
      ],
      "cwd": "${workspaceFolder}/my-github-mcp",
      "env": {
        "GIT_REPOSITORY_PATH": "${workspaceFolder}"
      }
    }
  }
}